WORKBOOK_PATH=cc_automation_ready.xlsx
MESSAGES_FILE=messages.txt
MESSAGES_FILE_HE=messages_he.txt
STATE_FILE=state.txt
ACTION_LOCK_FILE=action.lock
APP_LOCK_FILE=app.lock
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=
INSTAGRAM_SESSION_FILE=instagram_session.json
# Optional: paste the `sessionid` cookie value from an already logged-in browser session here to
# bootstrap the FIRST login without using the password endpoint. Only read once, when no
# instagram_session.json exists yet -- safe to blank out after the first successful run.
INSTAGRAM_SESSIONID=
TIMEZONE=Asia/Jerusalem
OPERATING_START=06:00
OPERATING_END=23:00
DAILY_MESSAGE_LIMIT=7
DAILY_FOLLOW_LIMIT=5
MESSAGE_READY_BUFFER=9
PROFILE_BATCH_LIMIT=5
PROFILE_CHECK_MIN_DELAY_SECONDS=20
PROFILE_CHECK_MAX_DELAY_SECONDS=60
STATUS_CHECK_HOURS=12
PRIVATE_FOLLOW_EXPIRY_DAYS=7
UNSEEN_EXPIRY_DAYS=7
SEEN_NO_REPLY_HOURS=48
MESSAGE_MIN_DELAY_HOURS=3
MESSAGE_MAX_DELAY_HOURS=4
FOLLOW_MIN_DELAY_HOURS=2.5
FOLLOW_MAX_DELAY_HOURS=3.5
CYCLE_SECONDS=60

# --- Follow-Back Timing V2 -----------------------------------------------------------------
# After a Follow succeeds, the DM is no longer sent immediately -- the lead waits up to
# FOLLOW_BACK_WAIT_HOURS (Y) for the target to follow us back first. Must be > 0 and less than
# FOLLOW_BACK_TIMEOUT_HOURS. See README.md "Follow-Back Timing" for the full behavior.
FOLLOW_BACK_WAIT_HOURS=24
FOLLOW_BACK_DM_DELAY_MINUTES=10
FOLLOW_BACK_TIMEOUT_HOURS=72
FOLLOW_BACK_CHECK_INTERVAL_MINUTES=10

# --- Multi-salesperson mode (optional) ---------------------------------------------------
# Off by default -- leave MULTI_SALESPERSON unset/false and everything above (WORKBOOK_PATH,
# STATE_FILE) works exactly as a normal single-workbook setup. Turn this on to run three
# independent lead workbooks through the one shared Instagram account above, with shared daily
# limits and pause/resume. See README.md "Multi-salesperson mode" for how it works.
MULTI_SALESPERSON=false
GLOBAL_STATE_FILE=global_state.txt
SP1_NAME=Salesperson 1
SP1_WORKBOOK=sales_1.xlsx
SP1_STATE=state_sales_1.txt
SP2_NAME=Salesperson 2
SP2_WORKBOOK=sales_2.xlsx
SP2_STATE=state_sales_2.txt
SP3_NAME=Salesperson 3
SP3_WORKBOOK=sales_3.xlsx
SP3_STATE=state_sales_3.txt
